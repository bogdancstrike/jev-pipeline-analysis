# Copy to .env.app on the application server. Replace 10.20.0.10 with the GPU server.
# Optional engines remain unused unless a task is configured to use them in Admin.
ENGINE_URLS='{"gliner":"http://10.20.0.10:18880","laya":"http://10.20.0.10:18881","kev":"http://10.20.0.10:18882","qwen":"http://10.20.0.10:18883"}'
PROD_SECRETS_DIR=./.secrets-prod
# Loopback for a reverse proxy on the application host; use its private IP for direct LAN access.
APP_BIND_IP=127.0.0.1
UI_PORT=8088
MAX_PARALLEL_JOBS=1
