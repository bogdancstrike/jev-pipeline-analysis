# vLLM OpenAI server (pinned) with a 4-bit AWQ model baked in at BUILD time.
# The running container has no route to the internet and needs none.
ARG VLLM_IMAGE=vllm/vllm-openai:v0.30.0
FROM ${VLLM_IMAGE}

# Qwen3-4B-Instruct-2507, AWQ W4A16 (llm-compressor), Apache-2.0. Runs on Ampere via Marlin kernels.
ARG LLM_MODEL_REPO=cyankiwi/Qwen3-4B-Instruct-2507-AWQ-4bit
# Pin a commit sha here for reproducible, auditable builds.
ARG LLM_MODEL_REVISION=main

# Weights become read-only for the image's unprivileged `vllm` user (UID 2000, GID 0).
RUN python3 -c "from huggingface_hub import snapshot_download as s; \
s('${LLM_MODEL_REPO}', revision='${LLM_MODEL_REVISION}', local_dir='/models/llm', \
  allow_patterns=['*.json', '*.safetensors', '*.txt', '*.jinja', 'merges.txt', 'vocab.json'])" \
 && rm -rf /models/llm/.cache \
 && chgrp -R 0 /models && chmod -R g=rX,o= /models

ENV HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 \
    HOME=/tmp/vllm-home VLLM_CACHE_ROOT=/tmp/vllm-cache XDG_CACHE_HOME=/tmp/cache \
    TRITON_CACHE_DIR=/tmp/triton VLLM_NO_USAGE_STATS=1 DO_NOT_TRACK=1
USER vllm

# API key comes from a file (generated by secrets-init), never from the compose file.
ENTRYPOINT ["/bin/sh", "-c", "export VLLM_API_KEY=\"$(cat /run/secrets/llm_api_key)\" && exec vllm serve /models/llm \"$@\"", "vllm"]
HEALTHCHECK --interval=5s --timeout=3s --start-period=300s --retries=3 \
  CMD python3 -c "import urllib.request,sys;sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/health',timeout=2).status==200 else 1)"
