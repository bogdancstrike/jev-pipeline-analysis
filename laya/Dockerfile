# Laya (Convai Innovations, Apache-2.0): non-autoregressive decision models behind
# `laya-serve`, which speaks the same POST /v1/systemone protocol as the vLLM decider.
#   english       convaiinnovations/laya (ModernBERT-large, 421M)
#   multilingual  convaiinnovations/laya subfolder (mmBERT-base, 322M, 100+ languages)
# Weights are baked in at BUILD time; the running container needs no network.
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 HF_HOME=/models/hf
ARG LAYA_VERSION=0.4.2
# Pin a commit sha for reproducible, auditable builds.
ARG LAYA_REVISION=main
RUN pip install "torch==2.8.0" "laya[serve]==${LAYA_VERSION}"
RUN python -c "from huggingface_hub import snapshot_download as s; \
s('convaiinnovations/laya', revision='${LAYA_REVISION}')" \
 && useradd -r -u 10001 app && chown -R 10001 /models
USER 10001
ENV HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HOME=/tmp \
    LAYA_HOST=0.0.0.0 LAYA_PORT=8000 LAYA_DEVICE=cuda LAYA_PRELOAD=1 \
    LAYA_MODELS=english,multilingual LAYA_MAX_LOADED=2 LAYA_DEFAULT_MODEL=multilingual \
    LAYA_MAX_TOKEN_BUDGET=4096 LAYA_MAX_CONCURRENT=32
EXPOSE 8000
# The API key comes from a file (generated by secrets-init), never from the compose file.
CMD ["sh", "-c", "export LAYA_API_KEY=\"$(cat /run/secrets/laya_api_key)\" && exec laya-serve"]
HEALTHCHECK --interval=5s --timeout=3s --start-period=180s --retries=3 \
  CMD python -c "import urllib.request,sys;sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/health',timeout=2).status==200 else 1)"
