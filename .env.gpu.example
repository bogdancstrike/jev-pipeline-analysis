# Copy to .env.gpu on the GPU server. Use the private LAN/VPN interface IP.
GPU_BIND_IP=10.20.0.10
GPU_DEVICE_ID=0
PROD_SECRETS_DIR=./.secrets-prod
# The defaults fit the development RTX 3080. Tune only after profiling the production GPU.
EXTRACTOR_GPU_MEM_FRACTION=0.35
EXTRACTOR_RELEASE_ABOVE_MB=2500
LAYA_MAX_BATCH_TOKENS=16384
